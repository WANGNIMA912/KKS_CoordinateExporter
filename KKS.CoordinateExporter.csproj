<Project Sdk="Microsoft.NET.Sdk">
  
  <PropertyGroup>
    <TargetFramework>net46</TargetFramework>
    <AssemblyName>KKS.CoordinateExporter</AssemblyName>
    <RootNamespace>KKS.CoordinateExporter</RootNamespace>
    <LangVersion>latest</LangVersion>
    <Deterministic>true</Deterministic>
    <Version>1.0.0</Version>
    <AppendTargetFrameworkToOutputPath>false</AppendTargetFrameworkToOutputPath>
    <GenerateAssemblyInfo>true</GenerateAssemblyInfo>
  </PropertyGroup>

  <PropertyGroup>
    <!-- 编译引用目录：仓库根 bin/（.gitignore 已忽略，来源见 bin/MANIFEST.md） -->
    
    <!-- 哈哈，正常情况哪怕你已经指向了游戏目录，也是编译不了的，沃壤依赖只想到了一个外部的单独文件夹 -->
    
    <RefDir Condition="'$(RefDir)' == ''">$(MSBuildThisFileDirectory)..\bin</RefDir>

    <!-- 只有 Deploy=true 时才用到 GameDir -->
    <GameDir Condition="'$(GameDir)' == ''">$(MSBuildThisFileDirectory)..\BepInEx_win_x64_5.4.23.5</GameDir>
    <DeployDir Condition="'$(DeployDir)' == ''">$(GameDir)\BepInEx\plugins\KKS_CoordinateExporter</DeployDir>
  </PropertyGroup>

  <ItemGroup>
    <Reference Include="BepInEx"><HintPath>$(RefDir)\BepInEx.dll</HintPath><Private>false</Private></Reference>
    <Reference Include="KKSAPI"><HintPath>$(RefDir)\KKSAPI.dll</HintPath><Private>false</Private></Reference>
    <Reference Include="KKS_ExtensibleSaveFormat"><HintPath>$(RefDir)\KKS_ExtensibleSaveFormat.dll</HintPath><Private>false</Private></Reference>
    <Reference Include="0Harmony"><HintPath>$(RefDir)\0Harmony.dll</HintPath><Private>false</Private></Reference>
    <Reference Include="Assembly-CSharp"><HintPath>$(RefDir)\Assembly-CSharp.dll</HintPath><Private>false</Private></Reference>
    <Reference Include="UnityEngine"><HintPath>$(RefDir)\UnityEngine.dll</HintPath><Private>false</Private></Reference>
    <Reference Include="UnityEngine.CoreModule"><HintPath>$(RefDir)\UnityEngine.CoreModule.dll</HintPath><Private>false</Private></Reference>
    <Reference Include="UnityEngine.InputLegacyModule"><HintPath>$(RefDir)\UnityEngine.InputLegacyModule.dll</HintPath><Private>false</Private></Reference>
    <Reference Include="UnityEngine.IMGUIModule"><HintPath>$(RefDir)\UnityEngine.IMGUIModule.dll</HintPath><Private>false</Private></Reference>
    <Reference Include="UnityEngine.TextRenderingModule"><HintPath>$(RefDir)\UnityEngine.TextRenderingModule.dll</HintPath><Private>false</Private></Reference>
    <Reference Include="UnityEngine.ImageConversionModule"><HintPath>$(RefDir)\UnityEngine.ImageConversionModule.dll</HintPath><Private>false</Private></Reference>
  </ItemGroup>
  
  <Target Name="CheckRefs" BeforeTargets="BeforeBuild">
    <Error Condition="!Exists('$(RefDir)\BepInEx.dll')"
           Text="Unable to resolve dependencies：$(RefDir)\BepInEx.dll&#10;Please copy dependencies to ../bin/ ." />
    <Error Condition="!Exists('$(RefDir)\KKSAPI.dll')"
           Text="Unable to resolve dependencies：$(RefDir)\KKSAPI.dll&#10;Please copy dependencies to ../bin/ ." />
    <Error Condition="!Exists('$(RefDir)\KKS_ExtensibleSaveFormat.dll')"
           Text="Unable to resolve dependencies：$(RefDir)\KKS_ExtensibleSaveFormat.dll&#10;Please copy BepInEx\plugins\KKS_BepisPlugins\KKS_ExtensibleSaveFormat.dll to ../bin/ ." />
    <Error Condition="!Exists('$(RefDir)\0Harmony.dll')"
           Text="Unable to resolve dependencies：$(RefDir)\0Harmony.dll&#10;Please copy BepInEx\core\0Harmony.dll to ../bin/ ." />
    <Error Condition="!Exists('$(RefDir)\Assembly-CSharp.dll')"
           Text="Unable to resolve dependencies：$(RefDir)\Assembly-CSharp.dll&#10;Please copy dependencies to ../bin/ ." />
    <Error Condition="!Exists('$(RefDir)\UnityEngine.IMGUIModule.dll') Or !Exists('$(RefDir)\UnityEngine.TextRenderingModule.dll')"
           Text="Unable to resolve IMGUI：$(RefDir)\UnityEngine.IMGUIModule.dll 或 UnityEngine.TextRenderingModule.dll&#10;Please copy dependencies to ../bin/ ." />
    <Error Condition="!Exists('$(RefDir)\UnityEngine.ImageConversionModule.dll')"
           Text="Unable to resolve dependencies：$(RefDir)\UnityEngine.ImageConversionModule.dll&#10;Please copy root\CharaStudio_Data\Managed to ../bin/ ." />
  </Target>

  <!-- dotnet build ... -p:Deploy=true -p:GameDir="..." -->
  <Target Name="DeployToGame" AfterTargets="Build" Condition="'$(Deploy)' == 'true'">
    <MakeDir Directories="$(DeployDir)" />
    <Copy SourceFiles="$(TargetPath)" DestinationFolder="$(DeployDir)" />
    <Message Importance="high" Text="Deployed $(TargetFileName) -> $(DeployDir)" />
  </Target>

</Project>
